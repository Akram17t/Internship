# Chat and FAQ generation via OpenAI-compatible endpoint
MODEL=kr/claude-sonnet-4.5
CHAT_BASE_URL=http://9router:20129/v1
CHAT_API_KEY=
OPENAI_COMPAT_NO_AUTH_BASE_URLS=http://9router:20129/v1
CHAT_TIMEOUT_SECONDS=240
CHUNK_AI_MAX_COMPLETION_TOKENS=16384
MODEL_NUM_PREDICT=4000

# Nscale hosted embeddings
NSCALE_SERVICE_TOKEN=
NSCALE_BASE_URL=https://inference.api.nscale.com/v1
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
EMBED_BATCH_SIZE=64

# Persistent production storage
DATA_DIR=/app/storage/data
CHROMA_DIR=/app/storage/chroma_db
CHUNK_CACHE_DIR=/app/storage/chunks
SEMANTIC_CACHE_DIR=/app/storage/semantic_chroma

# 9Router service
JWT_SECRET=
API_KEY_SECRET=

# PostgreSQL (required -- app fails fast at startup if unset). Fill in the
# real EC2/RDS endpoint and credentials for this environment.
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Secret used to derive stable pseudonymous user IDs for analytics (HMAC key).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ANALYTICS_PSEUDONYM_SECRET=

# Retrieval and semantic cache
TOP_K=6
RETRIEVAL_MIN_SCORE=0.3
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TOP_K=1
SEMANTIC_CACHE_VERSION=answer-style-v3-language-aware

# Frontend
TYPING_ANIMATION_ENABLED=false

# Auth (Google Workspace SSO)
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAIN=icscompute.com
INITIAL_ADMIN_EMAIL=

# Langfuse observability
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_TRACE_IO_MODE=masked
